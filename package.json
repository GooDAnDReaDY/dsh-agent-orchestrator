{
  "name": "@goodandready/dsh-agent-orchestrator",
  "version": "0.1.12",
  "description": "Multi-agent task decomposition, DAG workflow orchestration, and prompt caching optimizer for DeepSeek Harness.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "orchestrator",
    "multi-agent",
    "prompt-caching",
    "dag-workflow",
    "kanban"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GooDAnDReaDY/dsh-agent-orchestrator.git"
  },
  "homepage": "https://github.com/GooDAnDReaDY/dsh-agent-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/GooDAnDReaDY/dsh-agent-orchestrator/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <1.0.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6 <1.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <1.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <1.0.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <1.0.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "author": "GooDAnDReaDY <support@goodandready.app>"
}
